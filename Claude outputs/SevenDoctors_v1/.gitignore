# Library/ 만 해도 수 GB 라, 올리는 순간 clone 이 불가능해집니다.
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
